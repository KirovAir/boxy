@model VideoSettingsViewModel
@{
    ViewData["Title"] = "Video";
    ViewData["SettingsTab"] = "video";
    var header = new PageHeader { Title = "Settings", Icon = PageIcon.Settings };
}
<partial name="_PageHeader" model="header"/>
<partial name="_SettingsNav"/>

<div class="d-flex align-items-end justify-content-between flex-wrap gap-2 mb-2">
    <h2 class="h5 mb-0">Video</h2>
</div>
<p class="text-secondary small">
    How Boxy handles videos that not every browser can play. Video that is already 8-bit H.264 is never
    re-encoded, only repackaged where needed; H.265 and other formats go through the encoder. Originals are
    never touched, and videos already processed keep what they have until you use Convert again.
    @if (!Model.FromDb)
    {
        <text>Currently using the built-in defaults - save to override them.</text>
    }
</p>

<div class="card" style="max-width: 640px;">
    <div class="card-body">
        <form method="post" action="/settings/video">
            @Html.AntiForgeryToken()

            <div class="form-check form-switch mb-1">
                <input type="checkbox" name="neverReencode" value="true" class="form-check-input" id="neverReencode"
                       role="switch" @(Model.ConversionMode != ConversionMode.Full ? "checked" : "")/>
                <label class="form-check-label" for="neverReencode">Never re-encode videos</label>
            </div>
            <div class="form-text mb-4">
                For a light server. Every video is repackaged only, whatever the uploader or the box picked, so
                an H.265 phone clip stays H.265 and only plays where the browser can decode it.
            </div>

            <div class="form-check form-switch mb-1">
                <input type="checkbox" name="generatePosters" value="true" class="form-check-input" id="posters"
                       role="switch" @(Model.GeneratePosters ? "checked" : "")/>
                <label class="form-check-label" for="posters">Generate posters and thumbnails</label>
            </div>
            <div class="form-text mb-4">
                Poster frames for videos and thumbnails for photos (including iPhone HEIC) - a quick
                single-frame ffmpeg grab, independent of the setting above. Turn off to avoid every
                ffmpeg call on a minimal server; the gallery then falls back to a file-type icon.
            </div>

            <div class="form-check form-switch mb-1">
                <input type="checkbox" name="enableHls" value="true" class="form-check-input" id="hls"
                       role="switch" @(Model.EnableHls ? "checked" : "")/>
                <label class="form-check-label" for="hls">Package for iPhone and Safari (HLS)</label>
            </div>
            <div class="form-text mb-4">
                Repackages each video into the streaming form Safari handles best, so playback and
                scrubbing stay smooth on iPhones even over slow connections. No re-encode and no quality loss,
                but it roughly doubles the disk a video's converted files take. Applies from the next
                conversion; use Convert again on an existing video to add it.
            </div>

            <label class="form-label" for="defaultProfile">Default conversion</label>
            <select name="defaultProfile" id="defaultProfile" class="form-select mb-1" style="max-width: 24rem;">
                @foreach (var p in ConversionProfiles.Choices)
                {
                    <option value="@p" selected="@(p == Model.DefaultProfile)">@ConversionProfiles.Label(p)</option>
                }
            </select>
            <partial name="_ConversionHelp" model='new ConversionHelpVm { SelectId = "defaultProfile", Selected = Model.DefaultProfile }'/>
            <div class="form-text mb-4">
                What a video becomes when the uploader doesn't pick anything else. Boxes have their own default.
                Converting an H.265 phone clip is
                a full encode, so on a small server consider <span class="mono">medium</span> for the encoding
                speed below, or the GPU.
            </div>

            <label class="form-label" for="crf">Quality</label>
            <div class="input-group mb-1" style="max-width: 18rem;">
                <input type="number" name="crf" id="crf" class="form-control" min="14" max="35" value="@Model.Crf"/>
                <span class="input-group-text text-secondary">CRF</span>
            </div>
            <div class="form-text mb-4">
                Lower is better quality and a bigger file. <span class="mono">18</span> is visually lossless,
                <span class="mono">23</span> is noticeably smaller, <span class="mono">28</span> is small and
                soft. Below 14 the file grows enormously for no visible gain, so that's the floor.
            </div>

            <label class="form-label" for="maxedge">Max resolution</label>
            <div class="input-group mb-1" style="max-width: 18rem;">
                <input type="number" name="maxLongEdge" id="maxedge" class="form-control" min="0" max="4320"
                       value="@Model.MaxLongEdge"/>
                <span class="input-group-text text-secondary">px</span>
            </div>
            <div class="form-text mb-4">
                The longer edge of a re-encoded video is capped at this. <span class="mono">1920</span> is 1080p.
                Set <span class="mono">0</span> for no cap. 8-bit H.264 uploads are never re-encoded, so they keep
                their own size, and devices that play H.265 get the original at full size. Going above 1920 makes
                files much bigger, encoding much slower (4K on a small server can take hours per clip), and can push the video past what
                older phones and TVs will play.
            </div>

            <label class="form-label" for="encoder">Encoder</label>
            <select name="encoder" id="encoder" class="form-select mb-1" style="max-width: 24rem;">
                <option value="@VideoEncoder.Software" selected="@(Model.Encoder == VideoEncoder.Software)">
                    Software (CPU)
                </option>
                <option value="@VideoEncoder.Hardware" selected="@(Model.Encoder == VideoEncoder.Hardware)"
                        disabled="@(!Model.GpuAvailable)">
                    Hardware (GPU)@(Model.GpuAvailable ? "" : " - not available on this server")
                </option>
            </select>
            <div class="form-text mb-4">
                @if (Model.GpuAvailable)
                {
                    <text>
                        The CPU gives the best quality per byte and is slow: roughly real time for 1080p, and
                        several times that for 4K. The GPU is ten to thirty times faster and needs more bits for
                        the same picture, so files come out bigger, or the same size and slightly softer. With
                        H.265 phone clips going through the encoder, that trade is usually worth it.
                        The quality number below means something different to each of them, so expect to
                        re-tune it if you switch. A hardware encode that fails falls back to the CPU on its own.
                    </text>
                }
                else
                {
                    <text>
                        This server can't encode on a GPU: <span class="mono">@Model.GpuUnavailableReason</span>.
                        Everything runs on the CPU. In Docker, hardware encoding needs an x86 host with a render
                        node and <span class="mono">devices: - /dev/dri:/dev/dri</span> in your compose file.
                    </text>
                }
            </div>

            <label class="form-label" for="preset">Encoding speed</label>
            <select name="preset" id="preset" class="form-select mb-1" style="max-width: 18rem;">
                @foreach (var p in VideoSettings.AllowedPresets)
                {
                    <option value="@p" selected="@(string.Equals(Model.Preset, p, StringComparison.OrdinalIgnoreCase))">@p</option>
                }
            </select>
            <div class="form-text mb-4">
                How hard the encoder works. <span class="mono">slow</span> gives the best quality per byte;
                <span class="mono">veryfast</span> finishes sooner on a small server at the cost of a bigger
                file for the same quality.
            </div>

            <label class="form-label" for="maxrate">Max bitrate</label>
            <div class="input-group mb-1" style="max-width: 18rem;">
                <input type="number" name="maxrateKbps" id="maxrate" class="form-control" min="0" max="100000"
                       value="@Model.MaxrateKbps"/>
                <span class="input-group-text text-secondary">kbps</span>
            </div>
            <div class="form-text mb-4">
                Ceiling so a high-motion clip can't spike to a bitrate that stalls on a phone connection.
                Set <span class="mono">0</span> to let the quality setting decide on its own.
            </div>

            <button type="submit" class="btn btn-primary">Save</button>
        </form>
    </div>
</div>

@if (!Model.CanToneMap)
{
    <p class="text-secondary small mt-3" style="max-width: 640px;">
        This ffmpeg can't tone-map HDR (no <span class="mono">zscale</span>). An HDR upload's H.264 copy is
        labelled correctly but not converted, so it will look flat on the devices that fall back to it. The
        H.265 rendition still carries real HDR for the devices that can show it. The bundled Docker image
        does have zscale.
    </p>
}
