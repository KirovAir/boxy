@model AccountViewModel
@{
    ViewData["Title"] = "Account";
    var header = new PageHeader { Title = "Account", Icon = PageIcon.Account, Back = true };
    var me = Model.User;
    var hasKey = me.ApiKeyHash is not null;
    var agentPrompt = Model.NewApiKey is null
        ? null
        : $"Upload files to my Boxy at {Model.BaseUrl} with API key {Model.NewApiKey}. Read {Model.BaseUrl}/api for how.";
}
<partial name="_PageHeader" model="header"/>

<div class="card mb-4" style="max-width: 640px;">
    <div class="card-body">
        <dl class="facts mb-0">
            <dt>Name</dt>
            <dd>@(me.Name ?? "-")</dd>
            <dt>Email</dt>
            <dd class="text-break">@me.Email</dd>
            @if (me.Username is not null)
            {
                <dt>Username</dt>
                <dd>@me.Username</dd>
            }
        </dl>
    </div>
</div>

<div class="card" style="max-width: 640px;">
    <div class="card-body">
        <h2 class="h6 mb-1">API key</h2>
        <p class="text-secondary small mb-3">
            Lets scripts and AI agents upload files as shares in your name and read your shares. Anyone with
            the key can do that, so keep it like a password. How to use it: <a href="/api">@Model.BaseUrl/api</a>
        </p>

        @if (Model.NewApiKey is not null)
        {
            <div class="alert alert-secondary small">
                <div class="mb-2"><strong>Your new key.</strong> It's shown only now; copy it before you leave
                    this page.</div>
                <div class="d-flex gap-2 mb-3">
                    <input type="text" class="form-control form-control-sm mono" value="@Model.NewApiKey" readonly
                           aria-label="API key"/>
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-copy="@Model.NewApiKey"
                            data-copy-label="Copied!">Copy
                    </button>
                </div>
                <div class="mb-1">Or hand your agent this:</div>
                <div class="d-flex gap-2 align-items-start">
                    <textarea class="form-control form-control-sm mono" rows="3" readonly
                              aria-label="Instructions for an agent">@agentPrompt</textarea>
                    <button type="button" class="btn btn-sm btn-outline-secondary" data-copy="@agentPrompt"
                            data-copy-label="Copied!">Copy
                    </button>
                </div>
            </div>
        }
        else if (hasKey)
        {
            <p class="small mb-3">You have a key, made <partial name="_TimeAgo" model="me.ApiKeyCreatedAt!.Value"/>.</p>
        }
        else
        {
            <p class="small mb-3">You don't have a key yet.</p>
        }

        <div class="d-flex gap-2 flex-wrap">
            <form method="post" action="/account/api-key"
                  data-confirm="@(hasKey ? "Make a new key? The current one stops working right away." : null)">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-sm btn-primary">@(hasKey ? "Regenerate key" : "Generate key")</button>
            </form>
            @if (hasKey)
            {
                <form method="post" action="/account/api-key/revoke"
                      data-confirm="Revoke the key? Anything using it can no longer upload.">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-sm btn-outline-danger">Revoke</button>
                </form>
            }
        </div>
    </div>
</div>
